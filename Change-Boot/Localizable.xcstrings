            "value": "Dodaj system startowy"
          }
        }
      }
    },
    "Add a startup system to switch to.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a startup system to switch to."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj system startowy, na który chcesz się przełączać."
          }
        }
      }
    },
    "Add system": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add system"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj system"
          }
        }
      }
    },
    "Apps and windows from this session will not come back.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open apps will be closed first, so nothing comes back after the restart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwarte programy zostaną najpierw zamknięte, więc po restarcie nic nie wróci."
          }
        }
      }
    },
    "Blue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blue"
          }
        },
        "pl": {
