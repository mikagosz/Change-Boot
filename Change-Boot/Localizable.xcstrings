    "Move Change-Boot to the Applications folder first. The helper remembers where the app was when you installed it, so registering it from a build folder stops working after the next build.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Change-Boot to the Applications folder first. The helper remembers where the app was when you installed it, so registering it from a build folder stops working after the next build."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw przenieś Change-Boot do folderu Programy. Pomocnik zapamiętuje, gdzie program stał przy instalacji, więc zarejestrowany z folderu kompilacji przestanie działać po następnym budowaniu."
          }
        }
      }
    },
    "No other macOS installation is connected right now.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other macOS installation is connected right now."
