            "state": "translated",
            "value": "Nie udało się porozumieć z pomocnikiem.\n\n%@"
          }
        }
      }
    },
    "Could not write to the event log.\n\n%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not write to the event log.\n\n%@"
          }
        },
        "pl": {
