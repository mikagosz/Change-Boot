    "Change-Boot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change-Boot"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Change-Boot"
          }
        }
      }
    },
    "Change-Boot can also be driven from Terminal: list the systems, switch, eject, read the log. Useful when the switch has to happen from a script or on a schedule.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change-Boot can also be driven from Terminal: list the systems, switch, eject, read the log. Useful when the switch has to happen from a script or on a schedule."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Change-Bootem da się sterować także z terminala: wypisać systemy, przełączyć, wysunąć, przeczytać dziennik. Przydaje się, gdy przełączenie ma iść ze skryptu albo z harmonogramu."
          }
        }
      }
    },
    "Change-Boot has to restart to load the other language.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change-Boot has to restart to load the other language."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Change-Boot musi się uruchomić ponownie, żeby wczytać drugi język."
          }
        }
      }
    },
    "Change-Boot speaks Polish and English. Pick the language in Options, in the Change-Boot menu at the top of the screen, or in the menu bar icon. The app restarts when you change it, because the language is loaded once, when the app starts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change-Boot speaks Polish and English. Pick the language in Options, in the Change-Boot menu at the top of the screen, or in the menu bar icon. The app restarts when you change it, because the language is loaded once, when the app starts."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Change-Boot mówi po polsku i po angielsku. Język wybierzesz w Opcjach, w menu Change-Boot na górze ekranu albo w ikonie w pasku menu. Zmiana uruchamia program ponownie, bo język wczytuje się raz, przy starcie."
          }
        }
      }
    },
    "Changing the startup disk needs administrator rights. Install the helper once and Change-Boot stops asking for your password on every switch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the startup disk needs administrator rights. Install the helper once and Change-Boot stops asking for your password on every switch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana dysku startowego wymaga uprawnień administratora. Zainstaluj pomocnika raz, a Change-Boot przestanie pytać o hasło przy każdym przełączeniu."
          }
        }
      }
    },
    "Clean start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
