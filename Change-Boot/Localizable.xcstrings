    "bless reported success, but the startup disk is still /dev/%@ instead of /dev/%@. Restart was stopped — the Mac would have booted the wrong system.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "bless reported success, but the startup disk is still /dev/%@ instead of /dev/%@. Restart was stopped — the Mac would have booted the wrong system."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "bless zakończył się bez błędu, ale dysk startowy to nadal /dev/%@, a nie /dev/%@. Restart wstrzymany — Mac wystartowałby ze złego systemu."
          }
        }
      }
    },
    "macOS %@ · %@": {
